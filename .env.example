# 复制为 .env 并填值(.env 不会进 git)

# 可信 RAG 使用的 OpenAI 兼容同步模型配置
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=30

# 旧 hello_llm.py 热身脚本兼容；可信 RAG 不读取此变量
DEEPSEEK_API_KEY=

# 向量库(主用 Milvus;轻量可改 pgvector)
MILVUS_URI=http://localhost:19530
# PGVECTOR_DSN=postgresql+psycopg://user:pwd@localhost:5432/findoc

# 可观测
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# embedding / rerank 模型
EMBEDDING_MODEL=BAAI/bge-m3
RERANK_MODEL=BAAI/bge-reranker-v2-m3
